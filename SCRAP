import csv
import requests
from bs4 import BeautifulSoup

products = []
page = 1

headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

# حط الرابط المستهدف هنا
base_url = "https://bekastore6.com/"

while True:
    if page == 1:
        url = base_url
    else:
        # التعامل مع ترقيم الصفحات العام
        if "shopify" in base_url:
            url = f"{base_url}?page={page}"
        else:
            url = f"{base_url}page/{page}/"
            
    print(f"Scraping page {page}...")
    response = requests.get(url, headers=headers)
    
    if response.status_code != 200:
        break
        
    soup = BeautifulSoup(response.text, "html.parser")
    
    # ---------------------------------------------------------
    # بحث ذكي وعام عن العناوين والأثمنة بدون التقيد بكلاس واحد محدد
    # ---------------------------------------------------------
    titles = []
    prices = []
    
    # محاولة البحث عن العناوين بأساليب مختلفة (WooCommerce أو عناوين عامة)
    for tag in ["h2", "h3", "h1"]:
        found = soup.find_all(tag, class_=lambda x: x and ('title' in x or 'product' in x))
        if found:
            titles = found
            break
            
    # إذا لم يتم العثور عليها بالطريقة السابقة، نبحث بأي عنصر يحتوي على كلاس price أو amount للثمن
    for tag in ["span", "div", "p"]:
        found = soup.find_all(tag, class_=lambda x: x and ('price' in x or 'amount' in x))
        if found:
            prices = found
            break

    if not titles or not prices:
        print("No more products found or structure not matched.")
        break
        
    page_products = 0
    # أخذ الأقل عدداً لضمان التطابق بين العنوان والثمن
    limit = min(len(titles), len(prices))
    for i in range(limit):
        title = titles[i].text.strip()
        price = prices[i].text.strip()
        if title and price:
            products.append([title, price])
            page_products += 1
            
    print(f"Found {page_products} products on page {page}.")
    page += 1
    if page > 50: # حماية لتفادي اللانهائية
        break

# حفظ النتائج
with open("products.csv", "w", newline="", encoding="utf-8") as f:
    writer = csv.writer(f)
    writer.writerow(["Product Name", "Price"])
    writer.writerows(products)
    
print(f"Successfully scraped a total of {len(products)} products!")
