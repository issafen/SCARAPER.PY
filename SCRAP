import csv
from playwright.sync_api import sync_playwright

def run_scraper():
    products = []
    
    with sync_playwright() as p:
        # تشغيل المتصفح في الخلفية (Headless mode)
        browser = p.chromium.launch(headless=True)
        page = browser.new_page()
        
        url = "https://bekastore6.com/catalogue/"
        print(f"Opening {url}...")
        page.goto(url, timeout=60000)
        
        # محاكاة التمرير لأسفل الصفحة لترواض وتحميل جميع المنتجات (Infinite Scroll / Load More)
        last_height = page.evaluate("document.body.scrollHeight")
        
        while True:
            # الهبوط إلى أسفل الصفحة
            page.evaluate("window.scrollTo(0, document.body.scrollHeight);")
            page.wait_for_timeout(3000) # انتظار 3 ثواني باش يتحملو المنتجات الجداد
            
            # فحص واش الصفحة تزادت في الطول (بمعنى أن منتجات جداد بانوا)
            new_height = page.evaluate("document.body.scrollHeight")
            if new_height == last_height:
                # محاولة البحث عن زر "Load More" والنقر عليه إذا وجد
                try:
                    load_more_btn = page.locator("text=Load More") # أو كلاس الزر إذا كان معروفاً
                    if load_more_btn.is_visible():
                        load_more_btn.click()
                        page.wait_for_timeout(3000)
                        continue
                except:
                    pass
                
                print("Reached the bottom of the page or no more products.")
                break
            last_height = new_height
            print("Scrolling down to load more products...")

        # استخراج العناوين والأسعار بعد تحميل الصفحة كاملاً
        # ملاحظة: استبدل الكلاسات أدناه بالكلاسات الخاصة بـ bekastore6.com إذا كانت تختلف عن WoodMart
        titles = page.locator(".wd-entities-title, .product-title, h2").all_text_contents()
        prices = page.locator(".woocommerce-Price-amount, .price").all_text_contents()
        
        # تنظيف وتنسيق البيانات
        limit = min(len(titles), len(prices))
        for i in range(limit):
            title = titles[i].strip()
            price = prices[i].strip()
            if title and price:
                products.append([title, price])
                
        browser.close()

    # حفظ النتائج في ملف products.csv
    with open("products.csv", "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["Product Name", "Price"])
        writer.writerows(products)
        
    print(f"Successfully scraped a total of {len(products)} products using Playwright!")

if __name__ == "__main__":
    run_scraper()
