import csv
import requests
from bs4 import BeautifulSoup

# حط هنا الرابط ديال المتجر (مثلا موقعك أو أي موقع آخر كيخدم بـ WoodMart)
url = "https://oxytech.ma/shop/"

headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

response = requests.get(url, headers=headers)

if response.status_code == 200:
    soup = BeautifulSoup(response.text, "html.parser")
    products = []
    
    # في الغالب في ثيمات WooCommerce، المنتج كيكون داخل عنصر بحال product أو div عنده كلاسات مشابهة
    # غنستعملو BeautifulSoup للبحث عن العناوين والأثمنة مباشرة بفضل الكلاسات اللي دكيتي
    
    titles = soup.find_all(class_="wd-entities-title")
    prices = soup.find_all(class_="woocommerce-Price-amount amount")
    
    # دمج العناوين مع الأثمنة بناء على الترتيب في الصفحة
    for title_el, price_el in zip(titles, prices):
        title = title_el.text.strip()
        price = price_el.text.strip()
        products.append([title, price])
            
    # حفظ النتائج في ملف products.csv أوتوماتيكياً
    with open("products.csv", "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["Product Name", "Price"])
        writer.writerows(products)
        
    print(f"Successfully scraped {len(products)} products and saved to products.csv.")
else:
    print(f"Failed to fetch page, Status Code: {response.status_code}")
